NODE_ENV=production
PORT=5000

DATABASE_URL=postgresql://user:password@host:5432/tidum
SESSION_SECRET=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-long-random-secret

# ─── G-10-sikkerhetsherding: NYE PÅKREVDE hemmeligheter ──────────────────
# Se docs/security/g10-deployment-runbook.md for utrullingsrekkefølgen.
# Hver tokentype har sin EGEN hemmelighet: en lekket signeringsnøkkel skal
# ikke kunne brukes til å forfalske en annen tokentype. JWT_SECRET og
# SESSION_SECRET over brukes IKKE lenger som fallback for noen av disse —
# settes de ikke, kastes det en feil ved bruk (opak 500), ikke ved oppstart.

# Signerer/verifiserer Bearer-tokens (server/middleware/auth.ts,
# server/smartTimingRoutes.ts). ERSTATTER bruken av JWT_SECRET/SESSION_SECRET.
AUTH_JWT_SECRET=replace-with-a-long-random-secret

# Signerer magic-link-tokens for e-postinnlogging (server/custom-auth.ts).
# ERSTATTER bruken av JWT_SECRET/SESSION_SECRET.
EMAIL_MAGIC_LINK_SECRET=replace-with-a-long-random-secret

# AES-256-GCM-nøkkel for hemmeligheter lagret i databasen (PowerOffice
# client_key, SMTP-passord, TOTP-secrets). MÅ være nøyaktig 32 byte,
# base64-kodet: `openssl rand -base64 32`. Rotering krever re-kryptering av
# alle eksisterende rader (scripts/encrypt-existing-secrets.ts).
SECRETS_ENCRYPTION_KEY=replace-with-base64-of-32-random-bytes

# CSRF-token-signering (server/lib/csrf.ts). Egen hemmelighet, ikke delt.
CSRF_SECRET=replace-with-a-long-random-secret

# Tilkoblingsstreng for den RLS-håndhevede rollen `tidum_app` (migrasjon 052).
# Faller tilbake til DATABASE_URL hvis usatt — men da kjører alle requests som
# DATABASE_URL-rollen, og er den superuser/eier er FORCE RLS stille virkningsløs.
TIDUM_APP_DATABASE_URL=postgresql://tidum_app:password@host:5432/tidum

# Kun for lokal utvikling: slår på dev-innlogging uten OAuth. Krever i tillegg
# NODE_ENV != production. MÅ ALDRI settes i produksjon.
ALLOW_DEV_AUTH_BYPASS=false

APP_BASE_URL=https://tidum.no
APP_URL=https://tidum.no

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://tidum.no/api/auth/google/callback
CF_TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key
VITE_CF_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
CREATORHUB_SYNC_WEBHOOK_URL=https://creatorhub-backend.onrender.com/api/admin/tidum-access-requests/sync
TIDUM_CREATORHUB_SYNC_SECRET=replace-with-a-shared-random-secret

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp-user
SMTP_PASS=smtp-password
SMTP_FROM_NAME=Tidum
SMTP_FROM_EMAIL=hello@creatorhubn.com
SMTP_REPLY_TO=hello@creatorhubn.com

MANAGER_EMAIL=hello@creatorhubn.com
GITHUB_TOKEN=

DEFAULT_GA4_MEASUREMENT_ID=G-LTGH4LNPE3
DEFAULT_GA4_STREAM_ID=14316357971
DEFAULT_GTM_CONTAINER_ID=GTM-55SPZGMD
DEFAULT_ENABLE_ANALYTICS=true

# ─── Stripe (alle secrets i Render env, ikke DB) ─────────────────────────
# Hentes fra Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Signing secret per webhook-endpoint (Stripe Dashboard → Developers → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── GA4 server-side (Measurement Protocol) ──────────────────────────────
# Måle-ID kan også være DEFAULT_GA4_MEASUREMENT_ID over (samme verdi).
# API secret er separat og må opprettes:
# GA4 Admin → Data Streams → din web-stream →
#   Measurement Protocol API secrets → Create
GA4_MEASUREMENT_ID=G-...
GA4_API_SECRET=replace-with-mp-api-secret
