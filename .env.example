NODE_ENV=production
PORT=5000

DATABASE_URL=postgresql://user:password@host:5432/tidum
# Dedikert NOLOGIN/NOBYPASSRLS-rolle som applikasjonsloginen kan SET ROLE til.
# Utelatt verdi bruker pg_database_owner kun for kompatibel utviklingsdatabase.
TIDUM_RLS_RUNTIME_ROLE=tidum_app_runtime
SESSION_SECRET=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-long-random-secret

# Separate secrets for bearer tokens and email magic links. Neither falls
# back to JWT_SECRET or SESSION_SECRET.
AUTH_JWT_SECRET=replace-with-a-long-random-secret
EMAIL_MAGIC_LINK_SECRET=replace-with-a-long-random-secret
CSRF_SECRET=replace-with-a-long-random-secret

# Versjonert nøkkelsett for integrasjonshemmeligheter og sikker dialog.
# Velg nøyaktig én kilde: hvelv-injisert miljøverdi ELLER en absolutt,
# montert secret-fil med modus 0600/0400. Behold TIDUM_SECRET_KEY bare under
# overgang fra enc:v1. Ingen av verdiene skal ligge i en produksjons-.env.
TIDUM_SECRET_KEY=replace-with-the-current-legacy-secret
TIDUM_SECRET_KEYRING={"2026-08":"replace-with-at-least-32-random-bytes","2026-11":"replace-with-at-least-32-random-bytes"}
# TIDUM_SECRET_KEYRING_FILE=/run/secrets/tidum-keyring.json
TIDUM_SECRET_ACTIVE_KEY_ID=2026-11

# PowerOffice Go. Disse leverandørverdiene skal ligge i hemmelighetshvelv i
# produksjon. Kundens ClientKey legges inn i UI og forsegles med nøkkelringen
# over før lagring; den skal ikke legges i miljøfilen.
POWEROFFICE_APPLICATION_KEY=replace-with-poweroffice-application-key
POWEROFFICE_SUBSCRIPTION_KEY=replace-with-primary-subscription-key
POWEROFFICE_SUBSCRIPTION_KEY_SECONDARY=replace-with-secondary-subscription-key
POWEROFFICE_AUTH_URL=https://goapi.poweroffice.net/Demo/OAuth/Token
POWEROFFICE_BASE_URL=https://goapi.poweroffice.net/demo/v2

# Eksakt, kommaseparert vertsnavn-allowlist for Documaster-API og eventuell
# separat IDP. Obligatorisk i produksjon; private vertsnavn må også stå her.
ARCHIVE_ALLOWED_HOSTS=halden.documaster.example.no,idp.halden.documaster.example.no

# Local development only. Requires NODE_ENV != production and must never be
# enabled in production.
ALLOW_DEV_AUTH_BYPASS=false

APP_BASE_URL=https://tidum.no
APP_URL=https://tidum.no

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://tidum.no/api/auth/google/callback
CF_TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key
VITE_CF_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
CREATORHUB_SYNC_WEBHOOK_URL=https://creatorhub-backend.onrender.com/api/admin/tidum-access-requests/sync
TIDUM_CREATORHUB_SYNC_SECRET=replace-with-a-shared-random-secret

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp-user
SMTP_PASS=smtp-password
SMTP_FROM_NAME=Tidum
SMTP_FROM_EMAIL=hello@creatorhubn.com
SMTP_REPLY_TO=hello@creatorhubn.com

# Privat ClamAV/clamd-tjeneste for fail-closed skanning av sikre vedlegg.
CLAMAV_HOST=clamav.internal
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
SECURE_ATTACHMENT_QUARANTINE_DAYS=30

MANAGER_EMAIL=hello@creatorhubn.com
GITHUB_TOKEN=

DEFAULT_GA4_MEASUREMENT_ID=G-LTGH4LNPE3
DEFAULT_GA4_STREAM_ID=14316357971
DEFAULT_GTM_CONTAINER_ID=GTM-55SPZGMD
DEFAULT_ENABLE_ANALYTICS=true

# ─── Stripe (alle secrets i Render env, ikke DB) ─────────────────────────
# Hentes fra Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Signing secret per webhook-endpoint (Stripe Dashboard → Developers → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── GA4 server-side (Measurement Protocol) ──────────────────────────────
# Måle-ID kan også være DEFAULT_GA4_MEASUREMENT_ID over (samme verdi).
# API secret er separat og må opprettes:
# GA4 Admin → Data Streams → din web-stream →
#   Measurement Protocol API secrets → Create
GA4_MEASUREMENT_ID=G-...
GA4_API_SECRET=replace-with-mp-api-secret

# ═══ BARNEVERN-INTEGRASJONER (Halden / krav 1, 9, 10, 28) ════════════════
# Alle integrasjonene under er FAIL-CLOSED: uten komplett oppsett forblir
# køene trygt stående ('koet') og mottak/sending er inert. Lim inn verdiene
# etter hvert som de kommer fra KS/Digdir/Bufdir/gateway-leverandøren, og
# verifiser med GET /api/admin/integrasjoner/status.

# ─── Maskinporten (Digdir) — felles for FIKS send og mottak ──────────────
# Fra Digdirs selvbetjening (sjolvbetjening.samarbeid.digdir.no),
# scope ks:fiks. Privatnøkkelen forsegles med scripts/seal-secret eller
# sealSecret() før den legges her (aldri klartekst-PEM i env).
FIKS_MASKINPORTEN_KLIENT_ID=
FIKS_MASKINPORTEN_PRIVATE_KEY_SEALED=

# ─── KS FIKS IO — konto og integrasjon (forvaltning.fiks.ks.no) ──────────
# Kontoen eies av kommunen (Halden); integrasjonen av Tidum. Kommunen
# autoriserer integrasjonen på kontoen.
FIKS_IO_KONTO_ID=
FIKS_IO_INTEGRASJON_ID=
FIKS_IO_INTEGRASJON_PASSORD=
# Overstyr kun ved behov — default: api.fiks.test.ks.no utenfor produksjon.
#FIKS_IO_HOST=
#FIKS_IO_AMQP_HOST=

# ─── Barnevernsregisteret (Bufdir) — daglig innrapportering ──────────────
# Registerets FIKS-mottakerkonto og avtalt meldingstype fås fra Bufdir.
BVR_FIKS_MOTTAKER_KONTO_ID=
#BVR_FIKS_MELDINGSTYPE=no.bufdir.barnevernsregister.innrapportering.v1
# Fallback-transport (generisk REST) for sandkasse uten FIKS:
#BVR_API_URL=
#BVR_API_TOKEN=

# ─── FIKS IO-mottak av bekymringsmeldinger (Nasjonal portal) ─────────────
# Kommune-id i Tidum som innkommende meldinger på kontoen tilhører.
FIKS_MOTTAK_KOMMUNE_ID=
# Kontoens privatnøkkel (CMS-dekryptering), forseglet med secret-box.
FIKS_KONTO_PRIVATE_KEY_SEALED=
# Avtalt meldingstype + eksplisitt feltmapping fra DigiBarnevern-skjemaet.
# Uten disse blir mottatte meldinger trygt stående i råloggen og venter.
#FIKS_MOTTAK_MELDINGSTYPE=
#FIKS_MOTTAK_FELTMAPPING={"beskrivelse":"melding.beskrivelse","melderNavn":"melding.melder.navn","melderKontakt":"melding.melder.kontakt","barnNavn":"melding.barn.navn","barnFodselsnummer":"melding.barn.fodselsnummer"}

# ─── SMS-gateway (kundens leverandørnøytrale gateway, krav 9) ────────────
# Generisk REST-adapter: POST {to, message} med Bearer-token.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
# Overstyr payload-feltnavn om gatewayen bruker andre:
#SMS_GATEWAY_TO_FIELD=to
#SMS_GATEWAY_MESSAGE_FIELD=message
