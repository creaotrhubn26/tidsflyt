# Proxy API/auth calls from tidum.no to the Render backend, which is the
# only place the Express server (API + auth) actually runs. Netlify only
# ever serves the static frontend build.
/api/*  https://tidum-backend.onrender.com/api/:splat  200

# SPA fallback: client-side routes (e.g. /dashboard) have no matching static
# file on Netlify. Must come after the /api/* rule above — first match wins.
/*  /index.html  200
